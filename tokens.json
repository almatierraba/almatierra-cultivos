      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 650,
        "letterSpacing": {
          "value": 0.01,
          "unit": "em"
        }
